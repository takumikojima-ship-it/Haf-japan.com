    <script>
        // Header Scroll Effect
        const header = document.getElementById('header');
        const logoText = document.getElementById('logo-text');
        const navMenu = document.getElementById('nav-menu');
        const mobileBtn = document.getElementById('mobile-menu-btn');

        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                header.classList.add('bg-white', 'shadow-md', 'py-3');
                header.classList.remove('py-4');
                logoText.classList.replace('text-white', 'text-slate-900');
                navMenu.classList.replace('text-white', 'text-slate-600');
                mobileBtn.classList.replace('text-white', 'text-slate-900');
            } else {
                header.classList.remove('bg-white', 'shadow-md', 'py-3');
                header.classList.add('py-4');
                logoText.classList.replace('text-slate-900', 'text-white');
                navMenu.classList.replace('text-slate-600', 'text-white');
                mobileBtn.classList.replace('text-slate-900', 'text-white');
            }
        });

        // Mobile Menu Logic
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        
        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.remove('hidden');
        });

        document.getElementById('close-menu').addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });
    </script>
</body>
</html>
